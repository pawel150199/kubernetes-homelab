module "hcloud_kubernetes_cluster" {
  source = "git::https://github.com/pawel150199/hcloud-k8s-cluster.git?ref=0.1.20"

  worker_nodes_number = 1
  master_nodes_number = 1

  node_image = "ubuntu-26.04"
  # Instance CX23 can be sometimes not available
  # This instance is cost-optimized and is cheaper but sometimes can be not available
  master_node_type = "cx23"
  worker_node_type = "cx23"
  node_location    = "hel1"

  # Public IPv4 is kept enabled to allow outbound internet during bootstrap (e.g. Tailscale install).
  # Inbound access is restricted to Tailscale only via firewall rules below.
  use_public_ipv4 = true
  use_public_ipv6 = false

  # Restrict SSH and Kubernetes API to Tailscale network only
  # Tailscale uses CGNAT range 100.64.0.0/10
  ssh_source_ips      = ["100.64.0.0/10"]
  kube_api_source_ips = ["100.64.0.0/10"]

  # Extra TLS SANs for the Kubernetes API server certificate. This is required to allow access to the API server via Tailscale hostname
  extra_tls_sans = ["master-node-0.tail692efe.ts.net"]

  # Enable tailscale network
  # It will allow you to have secure not publicly available
  # K8S cluster with convinent access via tailscale network
  use_tailscale      = true
  tailscale_auth_key = var.tailscale_auth_key

  # Placement Group spread nodes on different physical machines. It decreases the probability that some instances might fail together
  use_placement_group = true

  # The only key you provide: the public key of your own machine.
  # The key pairs used between master and worker nodes are generated by the module.
  ssh_keys = ["ppolski"] # It have to be added manually in Hetzner Cloud console before running terraform apply

  private_network_ip_range        = "10.0.0.0/16"
  private_network_zone            = "eu-central"
  private_network_type            = "cloud"
  private_network_subnet_ip_range = "10.0.1.0/24"
}
