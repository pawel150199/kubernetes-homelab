module "hcloud_kubernetes_cluster" {
  source = "git::https://github.com/pawel150199/hcloud-k8s-cluster.git?ref=0.1.12"

  worker_nodes_number = 1
  master_nodes_number = 1

  node_image       = "ubuntu-26.04"
  master_node_type = "cx23" # This instance type is cost-optimized and it can be not available
  worker_node_type = "cx23" # This instance type is cost-optimized and it can be not available
  node_location    = "hel1"

  node_enable_ipv4 = true
  node_enable_ipv6 = true

  use_placement_group = true # placement group spread nodes on different physical machines. It decreaded the probability that some instances might fail together

  # The only key you provide: the public key of your own machine.
  # The key pairs used between master and worker nodes are generated by the module.
  ssh_keys = ["ppolski"]

  private_network_ip_range        = "10.0.0.0/16"
  private_network_zone            = "eu-central"
  private_network_type            = "cloud"
  private_network_subnet_ip_range = "10.0.1.0/24"
}
